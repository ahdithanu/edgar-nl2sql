# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string (use the *pooler* URL, port 6543, for app traffic).
# Format: postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=

# Anthropic API key — used for SQL generation and answer synthesis.
ANTHROPIC_API_KEY=

# Voyage AI API key — used for embedding the RAG corpus and incoming questions.
VOYAGE_API_KEY=

# Claude model for SQL generation (optional; defaults to claude-sonnet-5).
CLAUDE_MODEL=claude-sonnet-5

# Log verbosity for structlog JSON output (optional; defaults to INFO).
LOG_LEVEL=INFO

# --- Authentication & audit (P0) ---
# API keys now live in app_meta.api_keys (create via scripts/manage_keys.py),
# NOT in this file. QUERY_API_KEY below is the LEGACY single shared secret,
# still honored for backward compatibility; leave it unset once real keys exist.
# QUERY_API_KEY=
# Default per-principal requests/minute on POST /query; 0 disables. Default 30.
# RATE_LIMIT_PER_MINUTE=30
#
# Allow UNAUTHENTICATED /query as the built-in "anonymous" principal. OFF by
# default (secure). Set true ONLY for a public demo; keep the anonymous cap low.
# ANONYMOUS_PRINCIPAL_ENABLED=false
# ANONYMOUS_RATE_LIMIT_PER_MINUTE=5
#
# Append a tamper-evident row to app_meta.audit_log for every query. Default on.
# AUDIT_ENABLED=true
#
# Control-plane DSN for the credential store + audit log. Optional: falls back
# to DATABASE_URL. Set this to a DEDICATED least-privileged role (edgar_ctl,
# app_meta only) to fully isolate credentials/audit from the data-plane role
# that runs LLM-generated SQL. See scripts/002_auth_audit.sql.
# CONTROL_DATABASE_URL=

# --- Optional tuning knobs (defaults shown; uncomment to override) ---
# Voyage embedding model — must stay 1024-dim to match VECTOR(1024) in schema.sql.
# EMBED_MODEL=voyage-3.5-lite
# Context documents retrieved per question.
# RETRIEVAL_TOP_K=8
# Hard cap on rows returned to the client / fed to the LLM.
# MAX_RESULT_ROWS=200
# Server-side kill switch for runaway generated SQL, in milliseconds.
# STATEMENT_TIMEOUT_MS=10000
